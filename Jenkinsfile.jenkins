pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        PYTHON_VERSION = '3.9'
        VENV_DIR = '.venv'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '========== Checking out source code =========='
                checkout scm
                echo 'Source code checked out successfully'
            }
        }

        stage('Install Python') {
            steps {
                echo '========== Checking Python installation =========='
                script {
                    if (isUnix()) {
                        sh '''
                            python3 --version
                            if [ $? -ne 0 ]; then
                                echo "ERROR: Python3 not found. Please install Python 3.9+ on the Jenkins agent."
                                exit 1
                            fi
                        '''
                    } else {
                        bat '''
                            python --version
                            if errorlevel 1 (
                                echo ERROR: Python not found on this Windows agent
                                echo Please install Python 3.9+ from https://www.python.org/downloads/ with "Add Python to PATH" checked
                                echo Or run: choco install python39 -y ^(if Chocolatey is installed^)
                                exit /b 1
                            )
                        '''
                    }
                }
                echo 'Python is available'
            }
        }

        stage('Setup Environment') {
            steps {
                echo '========== Setting up Python environment =========='
                script {
                    if (isUnix()) {
                        sh '''
                            python -m venv ${VENV_DIR}
                            source ${VENV_DIR}/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    } else {
                        bat '''
                            python -m venv %VENV_DIR%
                            call %VENV_DIR%\\Scripts\\activate.bat
                            pip install --upgrade pip
                            pip install -r requirements.txt
                        '''
                    }
                }
                echo 'Dependencies installed successfully'
            }
        }

        stage('Code Quality Check') {
            steps {
                echo '========== Running code quality checks =========='
                script {
                    if (isUnix()) {
                        sh '''
                            source ${VENV_DIR}/bin/activate
                            pylint tests/ pages/ utilities/ locators/ --exit-zero || true
                        '''
                    } else {
                        bat '''
                            call %VENV_DIR%\\Scripts\\activate.bat
                            pylint tests/ pages/ utilities/ locators/ --exit-zero || true
                        '''
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                echo '========== Running automated tests =========='
                script {
                    if (isUnix()) {
                        sh '''
                            source ${VENV_DIR}/bin/activate
                            pytest tests/ -v --alluredir=allure-results
                        '''
                    } else {
                        bat '''
                            call %VENV_DIR%\\Scripts\\activate.bat
                            pytest tests/ -v --alluredir=allure-results
                        '''
                    }
                }
            }
        }

        stage('Generate Allure Report') {
            steps {
                echo '========== Generating Allure report =========='
                script {
                    if (isUnix()) {
                        sh '''
                            allure generate allure-results -o allure-report --clean
                        '''
                    } else {
                        bat '''
                            allure generate allure-results -o allure-report --clean
                        '''
                    }
                }
                echo 'Allure report generated successfully'
            }
        }

        stage('Publish Results') {
            steps {
                echo '========== Publishing test results =========='
                junit 'allure-results/**/*.xml'
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'allure-report',
                    reportFiles: 'index.html',
                    reportName: 'Allure Test Report'
                ])
                archiveArtifacts artifacts: 'allure-results/**/*,allure-report/**/*', 
                                  allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo '========== Cleaning up workspace =========='
            cleanWs(
                deleteDirs: true,
                patterns: [
                    [pattern: '**/*.pyc', type: 'INCLUDE'],
                    [pattern: '**/__pycache__', type: 'INCLUDE'],
                    [pattern: '.venv', type: 'INCLUDE']
                ]
            )
        }

        success {
            echo '✓ Pipeline completed successfully!'
        }

        failure {
            echo '✗ Pipeline failed. Check logs and test results above.'
        }

        unstable {
            echo '⚠ Pipeline unstable. Some tests may have failed.'
        }
    }
}
